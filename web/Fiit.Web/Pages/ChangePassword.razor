@page "/change-password"
@inject Api Api
@inject Session Session
@inject NavigationManager Nav

<div style="max-width:380px" class="panel">
    <h1>Смена пароля</h1>
    @if (Session.Me?.MustChangePassword == true)
    {
        <p class="muted">Вы вошли с временным паролем — задайте свой, чтобы продолжить.</p>
    }
    <form @onsubmit="Submit" class="col">
        <div class="field"><label>Текущий пароль</label><input type="password" @bind="_old" autocomplete="current-password" /></div>
        <div class="field"><label>Новый пароль (не короче 8 символов)</label><input type="password" @bind="_new" autocomplete="new-password" /></div>
        <div class="field"><label>Повторите новый пароль</label><input type="password" @bind="_repeat" autocomplete="new-password" /></div>
        <ErrorBox Message="@_error" />
        <button class="primary" type="submit">Сменить</button>
    </form>
</div>

@code {
    private string _old = "", _new = "", _repeat = "";
    private string? _error;

    private async Task Submit()
    {
        _error = null;
        if (_new != _repeat)
        {
            _error = "Пароли не совпадают";
            return;
        }
        try
        {
            var r = await Api.Post<LoginResponse>("api/auth/change-password", new ChangePasswordRequest(_old, _new));
            await Session.SetAsync(r.Token);
            Session.Me = await Api.Get<MeResponse>("api/me");
            Session.Notify();
            Nav.NavigateTo("courses");
        }
        catch (ApiError e)
        {
            _error = e.Message;
        }
    }
}
